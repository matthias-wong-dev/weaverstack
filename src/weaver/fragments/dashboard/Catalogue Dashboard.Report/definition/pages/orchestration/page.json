{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "orchestration",
  "displayName": "Load orchestration",
  "displayOption": "FitToPage",
  "height": 1080,
  "width": 1920,
  "objects": {
    "pageRefresh": [
      {
        "properties": {
          "show": {
            "expr": {
              "Literal": {
                "Value": "true"
              }
            }
          },
          "duration": {
            "expr": {
              "Literal": {
                "Value": "'PT30S'"
              }
            }
          }
        }
      }
    ]
  }
}
